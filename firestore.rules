rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check user role
    function hasRole(role) {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Users collection - admins can read all, users can read own
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || hasRole('admin'));
      allow create: if hasRole('admin');
      allow update: if request.auth.uid == userId || hasRole('admin');
      allow delete: if hasRole('admin');
    }

    // Students collection - admin only full access, teachers can read
    match /students/{studentId} {
      allow read: if isAuth();
      allow create, update, delete: if hasRole('admin');
    }

    // Teachers collection - admin only
    match /teachers/{teacherId} {
      allow read: if isAuth();
      allow create, update, delete: if hasRole('admin');
    }

    // Classes collection - admin only
    match /classes/{classId} {
      allow read: if isAuth();
      allow create, update, delete: if hasRole('admin');
    }

    // Subjects collection - admin only
    match /subjects/{subjectId} {
      allow read: if isAuth();
      allow create, update, delete: if hasRole('admin');
    }

    // Results collection - authenticated users can read and write
    match /results/{resultId} {
      allow read: if isAuth();
      allow create, update, delete: if hasRole('admin') || hasRole('teacher');
    }

    // Attendance collection
    match /attendance/{attendanceId} {
      allow read: if isAuth();
      allow create, update, delete: if hasRole('admin') || hasRole('teacher');
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow create, update, delete: if hasRole('admin');
    }

    // Fees collection
    match /fees/{feeId} {
      allow read: if isAuth();
      allow create, update, delete: if hasRole('admin');
    }

    // Settings collection - admin only
    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if hasRole('admin');
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
